    "/server/services/common/hko_rcd_1634806665997_63899/MapServer/WFSServer": {
      "get": {
        "operationId": "WfsMapServerGetFeature",
        "tags": [
          "WFS"
        ],
        "summary": "Retrieve published features",
        "description": "One read-only GET operation selects published feature types by name. Attribute types derive from retained DescribeFeatureType XSD when available; missing XSD, geometry, unread response data and unknown fields remain explicit limitations.",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "description": "OGC service identifier.",
            "schema": {
              "type": "string",
              "enum": [
                "WFS"
              ]
            },
            "example": "WFS"
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "description": "Exact capabilities version.",
            "schema": {
              "type": "string",
              "enum": [
                "2.0.0"
              ]
            },
            "example": "2.0.0"
          },
          {
            "name": "request",
            "in": "query",
            "required": true,
            "description": "Read-only operation advertised by GetCapabilities.",
            "schema": {
              "type": "string",
              "enum": [
                "GetFeature"
              ]
            },
            "example": "GetFeature"
          },
          {
            "name": "typeNames",
            "in": "query",
            "required": true,
            "description": "Published feature type names; multiple selections follow the advertised protocol syntax. Values are publisher identifiers; examples are choices, not a closed enumeration. The full ID/title directory is in x-csdi-layer-choices.",
            "schema": {
              "type": "string"
            },
            "examples": {
              "choice1": {
                "summary": "current_weather_report_weather_station",
                "value": "csdi:current_weather_report_weather_station"
              },
              "choice2": {
                "summary": "current_weather_report_lightning",
                "value": "csdi:current_weather_report_lightning"
              },
              "choice3": {
                "summary": "current_weather_report_rainfall",
                "value": "csdi:current_weather_report_rainfall"
              },
              "choice4": {
                "summary": "current_weather_report_hong_kong",
                "value": "csdi:current_weather_report_hong_kong"
              }
            },
            "x-choice-count": 4
          },
          {
            "name": "outputFormat",
            "in": "query",
            "required": false,
            "description": "Advertised native representation; JSON, GML, CSV and images are kept distinct.",
            "schema": {
              "type": "string",
              "enum": [
                "GML32",
                "GML32+ZIP",
                "GML32+GZIP",
                "application/gml+xml; version=3.2",
                "GML3",
                "GML3+ZIP",
                "GML3+GZIP",
                "text/xml; subtype=gml/3.1.1",
                "GML2",
                "GML2+ZIP",
                "GML2+GZIP",
                "text/xml; subtype=gml/2.1.2",
                "GEOJSON",
                "GEOJSON+ZIP",
                "GEOJSON+GZIP",
                "ESRIGEOJSON",
                "ESRIGEOJSON+ZIP",
                "ESRIGEOJSON+GZIP",
                "KML",
                "application/vnd.google-earth.kml xml",
                "application/vnd.google-earth.kml+xml",
                "KMZ",
                "application/vnd.google-earth.kmz",
                "SHAPE+ZIP",
                "CSV",
                "CSV+ZIP",
                "CSV+GZIP",
                "Geopackage",
                "Geopackage+ZIP"
              ]
            },
            "example": "GEOJSON"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "OGC bounded feature limit; example requests one feature without claiming a server-wide bound.",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "srsName",
            "in": "query",
            "required": false,
            "description": "Output CRS choices advertised by at least one feature type; support may vary by selected type.",
            "schema": {
              "type": "string"
            },
            "example": "urn:ogc:def:crs:EPSG::4326"
          }
        ],
        "responses": {
          "200": {
            "description": "Native publisher response; protocol or business errors may also be returned. Metadata connection and actual data-query success are separate.",
            "content": {
              "application/gml+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "text/xml": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WfsMapServerWfsFeatureCollection"
                }
              },
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/WfsMapServerWfsFeatureCollection"
                }
              },
              "application/vnd.google-earth.kml+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "*/*": {
                "schema": {
                  "description": "Native Geopackage+ZIP output; wire media type/fields are not constrained."
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "description": "Native CSV; row/column wire conformance is not inferred from JSON schemas."
                }
              }
            }
          }
        },
        "externalDocs": {
          "url": "https://docs.ogc.org/is/09-025r2/09-025r2.html"
        },
        "x-advertised-crss": [
          "urn:ogc:def:crs:EPSG::4326"
        ],
        "servers": [
          {
            "url": "https://portal.csdi.gov.hk"
          }
        ],
        "x-native-source-evidence": [
          {
            "url": "https://portal.csdi.gov.hk/server/services/common/hko_rcd_1634806665997_63899/MapServer/WFSServer?service=WFS&request=GetCapabilities",
            "sha256": "833b6723672ca16fa834830d78cc051bc9f84345bf120b24d6a56791caf92428",
            "httpStatus": 200,
            "contentType": "text/xml;charset=UTF-8",
            "role": "wfs-capabilities",
            "parseStatus": "pass",
            "kind": "wfs-capabilities"
          },
          {
            "url": "https://portal.csdi.gov.hk/server/services/common/hko_rcd_1634806665997_63899/MapServer/WFSServer?service=WFS&version=2.0.0&request=DescribeFeatureType",
            "sha256": "8f556a906d3887449f9f61e1a94db0da814f92cc40635cf8d37e69134fae600d",
            "httpStatus": 200,
            "contentType": "text/xml;charset=UTF-8",
            "role": "wfs-feature-type",
            "parseStatus": "pass",
            "kind": "wfs-feature-type"
          }
        ]
      }
    }
