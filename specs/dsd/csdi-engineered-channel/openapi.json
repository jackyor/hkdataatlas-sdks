          {
            "url": "https://portal.csdi.gov.hk/server/services/common/dsd_rcd_1742963120722_16615/MapServer/WMSServer?service=WMS&request=GetCapabilities",
            "sha256": "a12c783ebd31d811282a559cb3de85ab2e50bb92ec944c809ac52d30a8c4e605",
            "httpStatus": 200,
