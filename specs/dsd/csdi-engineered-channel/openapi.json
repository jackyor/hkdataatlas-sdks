    "/server/services/common/dsd_rcd_1742963120722_16615/MapServer/WMSServer": {
      "get": {
        "operationId": "WmsMapServerGetMap",
        "tags": [
          "WMS"
        ],
        "summary": "Render a map image",
        "description": "Map rendering returns its advertised native image/document representation. It does not return a feature JSON collection. Layer CRS, style and bounding-box choices are retained; no data observation is implied by metadata availability.",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "description": "OGC service identifier.",
            "schema": {
              "type": "string",
              "enum": [
                "WMS"
              ]
            },
            "example": "WMS"
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "description": "Exact advertised WMS version.",
            "schema": {
              "type": "string",
              "enum": [
                "1.3.0"
              ]
            },
            "example": "1.3.0"
          },
          {
            "name": "request",
            "in": "query",
            "required": true,
            "description": "Read-only GetMap operation.",
            "schema": {
              "type": "string",
              "enum": [
                "GetMap"
              ]
            },
            "example": "GetMap"
          },
          {
            "name": "layers",
            "in": "query",
            "required": true,
            "description": "Comma-separated published map layer names. Values are publisher identifiers; examples are choices, not a closed enumeration. The full ID/title directory is in x-csdi-layer-choices.",
            "schema": {
              "type": "string"
            },
            "examples": {
              "choice1": {
                "summary": "EngineeredChannel",
                "value": "EngineeredChannel"
              }
            },
            "x-choice-count": 1
          },
          {
            "name": "styles",
            "in": "query",
            "required": true,
            "description": "Comma-separated style names; an empty string selects the standard default style.",
            "schema": {
              "type": "string"
            },
            "example": "",
            "allowEmptyValue": true
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "description": "Advertised GetMap representation.",
            "schema": {
              "type": "string",
              "enum": [
                "image/bmp",
                "image/jpeg",
                "image/tiff",
                "image/png",
                "image/png8",
                "image/png24",
                "image/png32",
                "image/gif",
                "image/svg+xml"
              ]
            },
            "example": "image/png"
          },
          {
            "name": "width",
            "in": "query",
            "required": true,
            "description": "Requested image width in pixels; no invented maximum.",
            "schema": {
              "type": "integer"
            },
            "example": 256
          },
          {
            "name": "height",
            "in": "query",
            "required": true,
            "description": "Requested image height in pixels; no invented maximum.",
            "schema": {
              "type": "integer"
            },
            "example": 256
          },
          {
            "name": "crs",
            "in": "query",
            "required": true,
            "description": "Advertised coordinate reference system; support depends on selected layer. Observe the WMS version and CRS axis order.",
            "schema": {
              "type": "string"
            },
            "example": "CRS:84"
          },
          {
            "name": "bbox",
            "in": "query",
            "required": true,
            "description": "minx,miny,maxx,maxy in the chosen CRS and its specified axis order. Example, when present, is an actual advertised bounding box.",
            "schema": {
              "type": "string"
            },
            "example": "113.905621,22.213162,114.273660,22.563461"
          }
        ],
        "responses": {
          "200": {
            "description": "Native publisher response; protocol or business errors may also be returned. Metadata connection and actual data-query success are separate.",
            "content": {
              "image/bmp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/tiff": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png8": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png24": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/png32": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/gif": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "externalDocs": {
          "url": "https://portal.csdi.gov.hk/csdi-webpage/doc/GeoSpatialServices"
        },
        "x-advertised-crss": [
          "CRS:84",
          "EPSG:4326",
          "EPSG:2326",
          "EPSG:102140"
        ],
