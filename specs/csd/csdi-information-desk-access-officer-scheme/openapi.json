                  "type": "string",
                  "format": "binary"
                }
              },
              "image/svg+xml": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "externalDocs": {
          "url": "https://portal.csdi.gov.hk/csdi-webpage/doc/GeoSpatialServices"
        },
        "x-advertised-crss": [
          "CRS:84",
          "EPSG:4326"
        ],
