          {
            "url": "https://portal.csdi.gov.hk/server/services/common/csd_rcd_1666063670738_51225/MapServer/WMSServer?service=WMS&request=GetCapabilities",
            "sha256": "ff595c094b2e59d23b10d2f91b489c848771ae23354c2ac673ea66ce3bf5397f",
