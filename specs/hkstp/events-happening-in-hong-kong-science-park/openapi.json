  "info": {
    "description": "Provides information about upcoming events of Hong Kong Science and Technology Parks Corporation. The version value is a metadata placeholder, not a publisher API version. Authentication requirements are not specified in the documentation.",
    "title": "HKSTPC Events happening in Hong Kong Science Park API",
    "version": "undocumented"
  },
