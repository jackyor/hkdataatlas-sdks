          },
          {
            "url": "https://portal.csdi.gov.hk/server/rest/services/common/epd_rcd_1696984809000_78322/FeatureServer/1?f=pjson",
            "sha256": "42a141e9361a7ae5234328008a29417fd48fabcf354b48db3bc9108cd86b9038",
