{
  "openapi": "3.1.0",
  "info": {
    "title": "Agriculture, Fisheries and Conservation Department — Water Quality at Fish Culture Zones",
    "version": "csdi-native-readonly-v1",
    "description": "Deterministic derivative of retained native CSDI metadata. Read-only GET operations are selected only where native capabilities and protocol documentation support them. Publisher originals remain separate. Successful metadata retrieval does not prove current data-query success, complete response fields or all layer combinations."
  },
  "paths": {
    "/server/rest/services/common/afcd_rcd_1728898263131_82516/FeatureServer/{layerId}/query": {
      "get": {
        "operationId": "ArcgisFeatureServerQueryFeatures",
        "tags": [
          "ArcGIS REST"
        ],
        "summary": "Query published features",
        "description": "Read-only GET query follows the source-advertised Query capability. One parameterized operation covers all queryable layers. Metadata field types are declared without inventing universally required attributes. Omitted f may produce the native REST default representation, which is not asserted as a JSON payload.",
        "parameters": [
          {
            "name": "layerId",
            "in": "path",
            "required": true,
            "description": "Published queryable layer or table. Values are publisher identifiers; examples are choices, not a closed enumeration. The full ID/title directory is in x-csdi-layer-choices.",
            "schema": {
              "type": "integer"
            },
            "examples": {
              "choice1": {
                "summary": "RealTimeData_CSDI_master_v1",
                "value": 0
              }
            },
            "x-choice-count": 1
          },
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Advertised query representation. Supply this selector for the represented JSON/GeoJSON/PBF responses.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "geojson",
                "pbf"
              ]
            },
            "example": "json"
          },
          {
            "name": "where",
            "in": "query",
            "required": false,
            "description": "SQL WHERE expression over the published fields; source protocol supports this read-only query filter.",
            "schema": {
              "type": "string"
            },
            "example": "1=1"
          },
          {
            "name": "outFields",
            "in": "query",
            "required": false,
            "description": "Comma-separated source field names, or *. Field schemas are conditional on the selected layer and returned fields.",
            "schema": {
              "type": "string"
            },
            "example": "*"
          },
          {
            "name": "returnGeometry",
            "in": "query",
            "required": false,
            "description": "Whether native feature geometry should be included.",
            "schema": {
              "type": "boolean"
            },
            "example": false
          },
          {
            "name": "resultRecordCount",
            "in": "query",
            "required": false,
            "description": "Bound returned records where the selected layer advertises pagination; no global range is inferred.",
            "schema": {
              "type": "integer"
            },
            "example": 1,
            "x-supported-layer-ids": [
              0
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Native publisher response; protocol or business errors may also be returned. Metadata connection and actual data-query success are separate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArcgisFeatureServerArcgisJsonEnvelope"
                }
              },
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/ArcgisFeatureServerArcgisGeoJson"
                }
              },
              "application/x-protobuf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "externalDocs": {
          "url": "https://developers.arcgis.com/rest/services-reference/enterprise/query-feature-service-layer/"
        },
        "servers": [
          {
            "url": "https://portal.csdi.gov.hk"
          }
        ],
        "x-native-source-evidence": [
          {
            "url": "https://portal.csdi.gov.hk/server/rest/services/common/afcd_rcd_1728898263131_82516/FeatureServer?f=pjson",
            "sha256": "680846b75d8cb0b3c9b371448f72d3cebcc663d8631c54336f96b05858f97a56",
            "httpStatus": 200,
            "contentType": "text/plain;charset=UTF-8",
