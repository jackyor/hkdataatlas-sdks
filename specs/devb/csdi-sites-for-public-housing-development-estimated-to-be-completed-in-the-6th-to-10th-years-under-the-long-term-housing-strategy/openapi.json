  "info": {
    "title": "Development Bureau — Sites for Public Housing Development Estimated to be Completed in the 6th to 10th Years Under the Long Term Housing Strategy",
    "version": "csdi-native-readonly-v1",
    "description": "Deterministic derivative of retained native CSDI metadata. Read-only GET operations are selected only where native capabilities and protocol documentation support them. Publisher originals remain separate. Successful metadata retrieval does not prove current data-query success, complete response fields or all layer combinations."
  },
  "paths": {
    "/server/rest/services/common/devb_plb_rcd_1670236864007_29270/FeatureServer/{layerId}/query": {
      "get": {
        "operationId": "ArcgisFeatureServerQueryFeatures",
        "tags": [
          "ArcGIS REST"
        ],
        "summary": "Query published features",
        "description": "Read-only GET query follows the source-advertised Query capability. One parameterized operation covers all queryable layers. Metadata field types are declared without inventing universally required attributes. Omitted f may produce the native REST default representation, which is not asserted as a JSON payload.",
        "parameters": [
          {
            "name": "layerId",
            "in": "path",
            "required": true,
            "description": "Published queryable layer or table. Values are publisher identifiers; examples are choices, not a closed enumeration. The full ID/title directory is in x-csdi-layer-choices.",
            "schema": {
              "type": "integer"
            },
            "examples": {
              "choice1": {
                "summary": "geotagging",
                "value": 0
              }
            },
            "x-choice-count": 1
          },
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Advertised query representation. Supply this selector for the represented JSON/GeoJSON/PBF responses.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "geojson",
                "pbf"
              ]
            },
            "example": "json"
          },
          {
            "name": "where",
            "in": "query",
            "required": false,
            "description": "SQL WHERE expression over the published fields; source protocol supports this read-only query filter.",
            "schema": {
              "type": "string"
            },
            "example": "1=1"
          },
          {
            "name": "outFields",
            "in": "query",
            "required": false,
            "description": "Comma-separated source field names, or *. Field schemas are conditional on the selected layer and returned fields.",
            "schema": {
              "type": "string"
            },
            "example": "*"
          },
          {
            "name": "returnGeometry",
            "in": "query",
            "required": false,
            "description": "Whether native feature geometry should be included.",
            "schema": {
              "type": "boolean"
            },
            "example": false
          },
          {
            "name": "resultRecordCount",
            "in": "query",
            "required": false,
            "description": "Bound returned records where the selected layer advertises pagination; no global range is inferred.",
            "schema": {
              "type": "integer"
            },
            "example": 1,
            "x-supported-layer-ids": [
              0
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Native publisher response; protocol or business errors may also be returned. Metadata connection and actual data-query success are separate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArcgisFeatureServerArcgisJsonEnvelope"
                }
              },
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/ArcgisFeatureServerArcgisGeoJson"
                }
              },
              "application/x-protobuf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "externalDocs": {
          "url": "https://developers.arcgis.com/rest/services-reference/enterprise/query-feature-service-layer/"
        },
        "servers": [
          {
            "url": "https://portal.csdi.gov.hk"
          }
        ],
        "x-native-source-evidence": [
          {
            "url": "https://portal.csdi.gov.hk/server/rest/services/common/devb_plb_rcd_1670236864007_29270/FeatureServer?f=pjson",
            "sha256": "2affe45e19fbfc5b00246227d97f02d2b9425353fd0f851ec5f4056b683d48a2",
            "httpStatus": 200,
            "contentType": "text/plain;charset=UTF-8",
            "role": "arcgis-service",
            "parseStatus": "pass",
            "kind": "arcgis-service"
          },
          {
            "url": "https://portal.csdi.gov.hk/server/rest/services/common/devb_plb_rcd_1670236864007_29270/FeatureServer/0?f=pjson",
            "sha256": "a51a01091549b167664bdfe7c7b17e5335fc6c1d46a7f2f6c3b48e2567267b97",
            "httpStatus": 200,
            "contentType": "text/plain;charset=UTF-8",
            "role": "arcgis-layer",
            "parseStatus": "pass",
            "kind": "arcgis-layer"
          }
        ]
      }
    },
    "/server/services/common/devb_plb_rcd_1670236864007_29270/MapServer/WFSServer": {
      "get": {
        "operationId": "WfsMapServerGetFeature",
        "tags": [
          "WFS"
        ],
        "summary": "Retrieve published features",
        "description": "One read-only GET operation selects published feature types by name. Attribute types derive from retained DescribeFeatureType XSD when available; missing XSD, geometry, unread response data and unknown fields remain explicit limitations.",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "description": "OGC service identifier.",
            "schema": {
              "type": "string",
              "enum": [
                "WFS"
              ]
            },
            "example": "WFS"
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "description": "Exact capabilities version.",
            "schema": {
              "type": "string",
              "enum": [
                "2.0.0"
              ]
            },
            "example": "2.0.0"
          },
          {
            "name": "request",
            "in": "query",
            "required": true,
            "description": "Read-only operation advertised by GetCapabilities.",
            "schema": {
              "type": "string",
              "enum": [
                "GetFeature"
              ]
            },
            "example": "GetFeature"
          },
          {
            "name": "typeNames",
            "in": "query",
            "required": true,
            "description": "Published feature type names; multiple selections follow the advertised protocol syntax. Values are publisher identifiers; examples are choices, not a closed enumeration. The full ID/title directory is in x-csdi-layer-choices.",
            "schema": {
              "type": "string"
            },
            "examples": {
              "choice1": {
                "summary": "geotagging",
                "value": "csdi:geotagging"
              }
            },
            "x-choice-count": 1
          },
          {
            "name": "outputFormat",
            "in": "query",
            "required": false,
            "description": "Advertised native representation; JSON, GML, CSV and images are kept distinct.",
            "schema": {
              "type": "string",
              "enum": [
                "GML32",
                "GML32+ZIP",
                "GML32+GZIP",
                "application/gml+xml; version=3.2",
                "GML3",
                "GML3+ZIP",
                "GML3+GZIP",
                "text/xml; subtype=gml/3.1.1",
                "GML2",
                "GML2+ZIP",
                "GML2+GZIP",
                "text/xml; subtype=gml/2.1.2",
                "GEOJSON",
                "GEOJSON+ZIP",
                "GEOJSON+GZIP",
                "ESRIGEOJSON",
                "ESRIGEOJSON+ZIP",
                "ESRIGEOJSON+GZIP",
                "KML",
                "application/vnd.google-earth.kml xml",
                "application/vnd.google-earth.kml+xml",
                "KMZ",
                "application/vnd.google-earth.kmz",
                "SHAPE+ZIP",
                "CSV",
                "CSV+ZIP",
                "CSV+GZIP",
                "Geopackage",
                "Geopackage+ZIP"
              ]
            },
            "example": "GEOJSON"
          },
          {
            "name": "count",
            "in": "query",
            "required": false,
            "description": "OGC bounded feature limit; example requests one feature without claiming a server-wide bound.",
            "schema": {
              "type": "integer"
            },
            "example": 1
          },
          {
            "name": "srsName",
            "in": "query",
            "required": false,
            "description": "Output CRS choices advertised by at least one feature type; support may vary by selected type.",
            "schema": {
              "type": "string"
            },
            "example": "urn:ogc:def:crs:EPSG::4326"
          }
        ],
        "responses": {
          "200": {
            "description": "Native publisher response; protocol or business errors may also be returned. Metadata connection and actual data-query success are separate.",
            "content": {
              "application/gml+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "text/xml": {
                "schema": {
                  "type": "string"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WfsMapServerWfsFeatureCollection"
                }
              },
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/WfsMapServerWfsFeatureCollection"
                }
              },
              "application/vnd.google-earth.kml+xml": {
                "schema": {
                  "type": "string"
                }
              },
              "*/*": {
                "schema": {
                  "description": "Native Geopackage+ZIP output; wire media type/fields are not constrained."
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string",
                  "description": "Native CSV; row/column wire conformance is not inferred from JSON schemas."
                }
              }
            }
          }
        },
