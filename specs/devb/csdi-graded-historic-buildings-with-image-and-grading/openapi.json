          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "description": "Advertised GetMap representation.",
            "schema": {
              "type": "string",
              "enum": [
                "image/bmp",
                "image/jpeg",
                "image/tiff",
                "image/png",
                "image/png8",
                "image/png24",
                "image/png32",
                "image/gif",
                "image/svg+xml"
              ]
            },
            "example": "image/png"
          },
          {
            "name": "width",
            "in": "query",
            "required": true,
            "description": "Requested image width in pixels; no invented maximum.",
            "schema": {
              "type": "integer"
            },
            "example": 256
          },
          {
            "name": "height",
            "in": "query",
            "required": true,
            "description": "Requested image height in pixels; no invented maximum.",
            "schema": {
              "type": "integer"
            },
            "example": 256
          },
          {
            "name": "crs",
            "in": "query",
            "required": true,
            "description": "Advertised coordinate reference system; support depends on selected layer. Observe the WMS version and CRS axis order.",
            "schema": {
              "type": "string"
            },
            "example": "CRS:84"
          },
          {
            "name": "bbox",
            "in": "query",
            "required": true,
            "description": "minx,miny,maxx,maxy in the chosen CRS and its specified axis order. Example, when present, is an actual advertised bounding box.",
            "schema": {
              "type": "string"
            },
            "example": "113.843527,22.194255,114.434292,22.559607"
          }
        ],
