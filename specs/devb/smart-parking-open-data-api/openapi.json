  "externalDocs": {
    "description": "Smart Parking Open Data API 1.0 Specification",
    "url": "http://www.ekeo.gov.hk/filemanager/content/smart_city/common/smart_parking_open_api_specification_v1.0.pdf"
  },
  "info": {
    "description": "RESTful API for published carpark information and real-time parking vacancies, primarily for the Kowloon East area. The publisher documents the four resources below but does not state HTTP methods; GET is represented because the resources are read-only retrieval operations. The publisher explicitly states that the two vacancy resources require authentication and the information resources do not. Authentication details and credential format are not documented.",
    "title": "Smart Parking Open Data API",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/getCarpark": {
      "get": {
        "description": "Gets vacancy for a specific carpark. A valid carparkId is required. The documented example includes lang=en_US. Current exact anonymous request succeeded; historical v1.0 documentation says authentication required but gives no mechanism.",
        "operationId": "getCarparkVacancy",
        "parameters": [
          {
            "description": "System ID of the carpark.",
            "in": "query",
            "name": "carparkId",
            "required": true,
            "schema": {
              "type": "integer"
            }
          },
          {
            "description": "Present in the documented example request; parameter behavior and allowed values are not separately specified for this operation.",
            "in": "query",
            "name": "lang",
            "required": false,
            "schema": {
              "default": "en_US",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "examples": {
                  "example": {
                    "summary": "Example vacancy response",
                    "value": {
                      "results": {
                        "_id": 1,
                        "closed": false,
                        "lastUploadDate": "2015-09-16T04:38:00.353Z",
                        "motorCycle": {
                          "vacancy": 100,
                          "vacancyDIS": 0,
                          "vacancyEV": 0,
                          "vacancyUNL": 0
                        },
                        "privateCar": {
                          "vacancy": 200,
                          "vacancyDIS": 0,
                          "vacancyEV": 0,
                          "vacancyUNL": 0
                        }
                      }
                    }
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/CarparkInfoResponse"
                }
              }
            },
            "description": "Vacancy information for the carpark returned as JSON."
          },
          "default": {
            "description": "Error response not specified by the publisher."
          }
        },
        "summary": "Get carpark vacancy",
        "x-authentication-status": "anonymous_success_observed_documentation_disagrees"
      }
    },
