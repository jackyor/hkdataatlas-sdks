{
  "openapi": "3.1.0",
  "info": {
    "title": "Leisure and Cultural Services Department — Outdoor Fitness Equipment",
    "version": "csdi-native-readonly-v1",
    "description": "Deterministic derivative of retained native CSDI metadata. Read-only GET operations are selected only where native capabilities and protocol documentation support them. Publisher originals remain separate. Successful metadata retrieval does not prove current data-query success, complete response fields or all layer combinations."
  },
  "paths": {
    "/server/rest/services/common/lcsd_rcd_1670389505454_91091/FeatureServer/{layerId}/query": {
      "get": {
        "operationId": "ArcgisFeatureServerQueryFeatures",
        "tags": [
          "ArcGIS REST"
        ],
        "summary": "Query published features",
        "description": "Read-only GET query follows the source-advertised Query capability. One parameterized operation covers all queryable layers. Metadata field types are declared without inventing universally required attributes. Omitted f may produce the native REST default representation, which is not asserted as a JSON payload.",
        "parameters": [
          {
            "name": "layerId",
            "in": "path",
            "required": true,
            "description": "Published queryable layer or table. Values are publisher identifiers; examples are choices, not a closed enumeration. The full ID/title directory is in x-csdi-layer-choices.",
            "schema": {
              "type": "integer"
            },
            "examples": {
              "choice1": {
                "summary": "geotagging",
                "value": 0
              }
            },
            "x-choice-count": 1
          },
          {
            "name": "f",
            "in": "query",
            "required": false,
            "description": "Advertised query representation. Supply this selector for the represented JSON/GeoJSON/PBF responses.",
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "geojson",
                "pbf"
              ]
            },
            "example": "json"
          },
          {
            "name": "where",
            "in": "query",
            "required": false,
            "description": "SQL WHERE expression over the published fields; source protocol supports this read-only query filter.",
            "schema": {
              "type": "string"
            },
            "example": "1=1"
          },
          {
            "name": "outFields",
            "in": "query",
            "required": false,
            "description": "Comma-separated source field names, or *. Field schemas are conditional on the selected layer and returned fields.",
            "schema": {
              "type": "string"
            },
            "example": "*"
          },
          {
            "name": "returnGeometry",
            "in": "query",
            "required": false,
            "description": "Whether native feature geometry should be included.",
            "schema": {
              "type": "boolean"
            },
            "example": false
          },
          {
            "name": "resultRecordCount",
            "in": "query",
            "required": false,
            "description": "Bound returned records where the selected layer advertises pagination; no global range is inferred.",
            "schema": {
              "type": "integer"
            },
            "example": 1,
            "x-supported-layer-ids": [
              0
            ]
          }
        ],
        "responses": {
          "200": {
            "description": "Native publisher response; protocol or business errors may also be returned. Metadata connection and actual data-query success are separate.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArcgisFeatureServerArcgisJsonEnvelope"
                }
              },
              "application/geo+json": {
                "schema": {
                  "$ref": "#/components/schemas/ArcgisFeatureServerArcgisGeoJson"
                }
              },
              "application/x-protobuf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          }
        },
        "externalDocs": {
          "url": "https://developers.arcgis.com/rest/services-reference/enterprise/query-feature-service-layer/"
        },
        "servers": [
          {
            "url": "https://portal.csdi.gov.hk"
          }
        ],
        "x-native-source-evidence": [
          {
            "url": "https://portal.csdi.gov.hk/server/rest/services/common/lcsd_rcd_1670389505454_91091/FeatureServer?f=pjson",
            "sha256": "cde1ed08bed2a3e99522f9abf0487da405af342b8e87f92859c8aeac8fb8ae4e",
            "httpStatus": 200,
            "contentType": "text/plain;charset=UTF-8",
            "role": "arcgis-service",
            "parseStatus": "pass",
            "kind": "arcgis-service"
          },
          {
            "url": "https://portal.csdi.gov.hk/server/rest/services/common/lcsd_rcd_1670389505454_91091/FeatureServer/0?f=pjson",
            "sha256": "9d2e3e604b34a72c4a11eea6e48dcaaedd8b7330f038e36481227b66d10b6c0e",
            "httpStatus": 200,
            "contentType": "text/plain;charset=UTF-8",
            "role": "arcgis-layer",
            "parseStatus": "pass",
            "kind": "arcgis-layer"
          }
        ]
      }
    },
    "/server/services/common/lcsd_rcd_1670389505454_91091/MapServer/WMSServer": {
      "get": {
        "operationId": "WmsMapServerGetMap",
        "tags": [
          "WMS"
        ],
        "summary": "Render a map image",
        "description": "Map rendering returns its advertised native image/document representation. It does not return a feature JSON collection. Layer CRS, style and bounding-box choices are retained; no data observation is implied by metadata availability.",
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": true,
            "description": "OGC service identifier.",
            "schema": {
              "type": "string",
              "enum": [
                "WMS"
              ]
            },
            "example": "WMS"
          },
          {
            "name": "version",
            "in": "query",
            "required": true,
            "description": "Exact advertised WMS version.",
            "schema": {
              "type": "string",
              "enum": [
                "1.3.0"
              ]
            },
            "example": "1.3.0"
          },
          {
            "name": "request",
            "in": "query",
            "required": true,
            "description": "Read-only GetMap operation.",
            "schema": {
              "type": "string",
              "enum": [
                "GetMap"
              ]
            },
            "example": "GetMap"
          },
          {
            "name": "layers",
            "in": "query",
            "required": true,
            "description": "Comma-separated published map layer names. Values are publisher identifiers; examples are choices, not a closed enumeration. The full ID/title directory is in x-csdi-layer-choices.",
            "schema": {
              "type": "string"
            },
            "examples": {
              "choice1": {
                "summary": "geotagging",
                "value": "geotagging"
              }
            },
            "x-choice-count": 1
          },
          {
            "name": "styles",
            "in": "query",
            "required": true,
            "description": "Comma-separated style names; an empty string selects the standard default style.",
            "schema": {
              "type": "string"
            },
            "example": "",
            "allowEmptyValue": true
          },
          {
            "name": "format",
            "in": "query",
            "required": true,
            "description": "Advertised GetMap representation.",
            "schema": {
              "type": "string",
              "enum": [
                "image/bmp",
                "image/jpeg",
                "image/tiff",
                "image/png",
                "image/png8",
                "image/png24",
                "image/png32",
                "image/gif",
                "image/svg+xml"
              ]
            },
            "example": "image/png"
          },
          {
            "name": "width",
            "in": "query",
            "required": true,
            "description": "Requested image width in pixels; no invented maximum.",
            "schema": {
              "type": "integer"
            },
            "example": 256
          },
          {
            "name": "height",
            "in": "query",
            "required": true,
            "description": "Requested image height in pixels; no invented maximum.",
            "schema": {
              "type": "integer"
            },
            "example": 256
          },
          {
            "name": "crs",
            "in": "query",
            "required": true,
            "description": "Advertised coordinate reference system; support depends on selected layer. Observe the WMS version and CRS axis order.",
            "schema": {
              "type": "string"
            },
            "example": "CRS:84"
          },
          {
            "name": "bbox",
            "in": "query",
            "required": true,
            "description": "minx,miny,maxx,maxy in the chosen CRS and its specified axis order. Example, when present, is an actual advertised bounding box.",
            "schema": {
              "type": "string"
            },
            "example": "113.862222,22.201667,114.358611,22.547222"
          }
        ],
        "responses": {
          "200": {
            "description": "Native publisher response; protocol or business errors may also be returned. Metadata connection and actual data-query success are separate.",
            "content": {
              "image/bmp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              },
              "image/jpeg": {
