      "PublisherDictionaryStudentEnrolmentHeadcountDataDictionary": {
        "description": "Dictionary for Student Enrolment (Headcount) of UGC-funded Programmes by University, Level of Study, Mode of Study and Academic Programme Category. This describes data fields, not a documented HTTP response schema. Supporting semantic context from the publisher DOCX dictionary https://www.ugcs.gov.hk/datagovhk/Students3_data_dictionary_en.docx. Native ArcGIS/WFS wire names and types remain in their own operation schemas; a dictionary-to-wire mapping is not asserted.",
        "properties": {
          "Academic Programme Category_EN": {
            "description": "Academic Programme Category in English.",
            "enum": [
              "Medicine",
              "Dentistry",
              "Studies Allied to Medicine and Health",
              "Biological Sciences",
              "Physical Sciences",
              "Mathematical Sciences",
              "Computer Science and Information Technology",
              "Engineering and Technology",
              "Architecture and Town Planning",
              "Business and Management Studies",
              "Social Sciences",
              "Law",
              "Media, Journalism and Communications",
              "Languages and Related Studies",
              "Humanities",
              "Arts, Design and Performing Arts",
              "Education"
            ],
            "type": "string"
          },
          "Academic Programme Category_TC": {
            "description": "Academic Programme Category in Traditional Chinese.",
            "enum": [
              "醫學",
              "牙醫學",
              "與醫學及衛生有關的學科",
              "生物科學",
              "物理科學",
              "數學科學",
              "電腦科學及資訊科技",
              "工程及科技",
              "建築學及城市規劃",
              "工商管理",
              "社會科學",
              "法律",
              "媒體、新聞及傳播",
              "語言及相關科目",
              "人文學科",
              "藝術、設計及演藝",
              "教育"
            ],
            "type": "string"
          },
          "Academic Year": {
            "description": "Academic year in YYYY/YY format (for example, 2018/19).",
            "pattern": "^[0-9]{4}/[0-9]{2}$",
            "type": "string"
          },
          "Level of study_EN": {
            "description": "Level of study in English.",
            "enum": [
              "Sub-degree",
              "Undergraduate",
              "Taught Postgraduate",
              "Research Postgraduate"
            ],
            "type": "string"
          },
          "Level of study_TC": {
            "description": "Level of study in Traditional Chinese.",
            "enum": [
              "副學位課程",
              "學士學位課程",
              "研究院修課課程",
              "研究院研究課程"
            ],
            "type": "string"
          },
          "Mode of study_EN": {
            "description": "Mode of study in English.",
            "enum": [
              "Full-time",
              "Part-time"
            ],
            "type": "string"
          },
          "Mode of study_TC": {
            "description": "Mode of study in Traditional Chinese.",
            "enum": [
              "全日制",
              "兼讀制"
            ],
            "type": "string"
          },
          "Student Enrolment (Headcount)": {
            "description": "Student enrolment headcount. The dictionary declares an Integer format. Some UGC-funded programmes map to multiple academic programme categories and are allocated across those categories on a pro rata basis; the resulting figures may be decimal. Figures in this table are rounded to the nearest whole number and may not add up to corresponding totals.",
            "type": "integer"
          },
          "University_EN": {
            "description": "University name in English.",
            "enum": [
              "City University of Hong Kong",
              "Hong Kong Baptist University",
              "Lingnan University",
              "The Chinese University of Hong Kong",
              "The Education University of Hong Kong",
              "The Hong Kong Polytechnic University",
              "The Hong Kong University of Science and Technology",
              "The University of Hong Kong"
            ],
            "type": "string"
          },
          "University_TC": {
