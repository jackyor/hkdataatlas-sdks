            "kind": "arcgis-service"
          },
          {
            "url": "https://portal.csdi.gov.hk/server/rest/services/common/had_rcd_1634522917609_57950/FeatureServer/0?f=pjson",
            "sha256": "faa8298fca023e9d5c9fbe6eb49a5df5804624b7ef996bb4cb4d55d643f20800",
