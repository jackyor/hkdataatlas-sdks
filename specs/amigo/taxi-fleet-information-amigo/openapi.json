{
  "components": {
    "schemas": {
      "TaxiFleetTdSlimRecord": {
        "description": "Slim vehicle record with latest GPS status. Field requiredness is not specified.",
        "properties": {
          "lat": {
            "description": "Current latitude, documented to 6 decimal places with accuracy ±0.5%. Preserves documented numbers and observed null for an unavailable coordinate; no value is fabricated.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "long": {
            "description": "Current longitude, documented to 6 decimal places with accuracy ±0.5%. Preserves documented numbers and observed null for an unavailable coordinate; no value is fabricated.",
            "format": "float",
            "type": [
              "number",
              "null"
            ]
          },
          "op_status": {
            "description": "Occupied (O), Vacant (V), or No service (N).",
            "enum": [
              "O",
              "V",
              "N"
            ],
            "type": "string"
          },
          "passenger_cap": {
            "description": "Seating capacity; whole number or null.",
            "type": [
              "integer",
              "null"
            ]
          },
          "taxi_type": {
            "description": "Vehicle type.",
            "enum": [
              "O",
              "P",
              "W"
            ],
            "type": "string"
          },
          "time_stamp": {
            "description": "Data received time in ISO 8601 with +08:00 timezone.",
            "format": "date-time",
            "type": "string"
          },
          "veh_id": {
            "description": "Vehicle ID. Documented format: stable 12-character identifier.",
            "type": "string"
          }
        },
        "type": "object"
      },
      "VehicleListResponse": {
        "properties": {
          "taxis": {
            "description": "TaxiFleetTdSlimRecord entries. The response example uses a placeholder for the array contents.",
            "items": {
              "$ref": "#/components/schemas/TaxiFleetTdSlimRecord"
            },
            "type": "array"
          }
        },
        "type": "object"
      }
    }
  },
  "externalDocs": {
    "description": "Official API documentation",
    "url": "https://www.td.gov.hk/datagovhk_td/taxi-fleet-information-amigo/Amigo_spec.pdf"
  },
  "info": {
    "description": "HTTP API usage guide for slim taxi vehicle records. The version is undocumented and is not a publisher API version. Authentication requirements are not specified.",
    "title": "Taxi Fleet Information (Amigo) Webx API",
    "version": "undocumented"
  },
  "openapi": "3.1.0",
  "paths": {
    "/webx/v1/vehicle/list": {
      "get": {
        "description": "Returns a slim vehicle list with their latest GPS status.",
        "operationId": "listVehicles",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "taxis": []
                },
                "schema": {
                  "$ref": "#/components/schemas/VehicleListResponse"
                }
              }
            },
            "description": "Successful response"
          }
        },
        "summary": "List vehicles"
      }
    },
    "/webx/v1/vehicle/nearby": {
      "get": {
        "description": "Finds slim vehicles within a geographic radius from a given location. Results are sorted by distance ascending. Each record includes a distance field (as a string) indicating distance from the query center; the documented TaxiFleetTdSlimRecord schema does not specify that field's exact structure.",
        "operationId": "findNearbyVehicles",
        "parameters": [
          {
            "description": "Center latitude, in 6 decimal degrees.",
            "in": "query",
            "name": "lat",
            "required": true,
            "schema": {
              "format": "float",
              "maximum": 90,
              "minimum": -90,
              "type": "number"
            }
          },
          {
            "description": "Center longitude, in 6 decimal degrees.",
            "in": "query",
            "name": "lng",
            "required": true,
            "schema": {
              "format": "float",
              "maximum": 180,
              "minimum": -180,
              "type": "number"
            }
          },
          {
            "description": "Search radius. Default: 5.",
            "in": "query",
            "name": "radius",
            "required": false,
            "schema": {
              "default": 5,
              "type": "integer"
            }
          },
          {
            "description": "Distance unit. Default: km.",
            "in": "query",
            "name": "unit",
            "required": false,
            "schema": {
              "default": "km",
              "enum": [
                "m",
                "km",
                "mi",
                "ft"
              ],
              "type": "string"
            }
          },
          {
            "description": "Maximum results to return. Default is undocumented; maximum 200.",
            "in": "query",
            "name": "count",
            "required": false,
            "schema": {
              "maximum": 200,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "example": {
                  "taxis": []
                },
                "schema": {
                  "$ref": "#/components/schemas/VehicleListResponse"
                }
              }
            },
            "description": "Successful response. Vehicles are sorted by distance ascending; each returned record includes distance from the query center as a string."
          },
          "400": {
            "description": "Invalid latitude/longitude range, or unrecognized unit."
          }
        },
        "summary": "Find nearby vehicles"
      }
    }
  },
  "servers": [
    {
      "url": "https://api.amigo.taxi"
    }
  ],
